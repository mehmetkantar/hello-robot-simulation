<mujoco model="stretch simple office scene">
  <include file="stretch.xml"/>

  <statistic center="0 0 .75" extent="10" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <material name="floor" rgba=".8 .8 .9 1" reflectance="0.2"/>
    <material name="wall" rgba=".9 .9 .8 1" reflectance="0.1"/>
    <material name="furniture" rgba=".5 .3 .2 1" reflectance="0.1"/>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <light pos="3 3 3" dir="0 0 -1" diffuse="0.4 0.4 0.4"/>
    
    <!-- Large open floor - Robot starts at (0,0) which is center of open space -->
    <geom name="floor" size="6 5 0.05" type="plane" material="floor"/>
    
    <!-- Walls -->
    <geom name="wall_north" type="box" size="6 0.1 1.5" pos="0 4.9 1.5" material="wall"/>
    <geom name="wall_south" type="box" size="6 0.1 1.5" pos="0 -4.9 1.5" material="wall"/>
    <geom name="wall_east" type="box" size="0.1 5 1.5" pos="5.9 0 1.5" material="wall"/>
    <geom name="wall_west" type="box" size="0.1 5 1.5" pos="-5.9 0 1.5" material="wall"/>
    
    <!-- Some furniture away from center -->
    <!-- Desk in corner -->
    <body name="desk1" pos="4 3 0.4">
      <geom type="box" size="1.2 0.8 0.4" material="furniture"/>
    </body>
    
    <!-- Chair near desk -->
    <body name="chair1" pos="2.5 3 0.25">
      <geom type="cylinder" size="0.3 0.25" material="furniture"/>
    </body>
    
    <!-- Table in other corner -->
    <body name="table1" pos="-4 -3 0.4">
      <geom type="box" size="1.0 1.0 0.4" material="furniture"/>
    </body>
    
    <!-- Bookshelf along wall -->
    <body name="bookshelf1" pos="-5.7 2 1.0">
      <geom type="box" size="0.2 1.5 1.0" material="furniture"/>
    </body>
    
    <!-- Robot safe starting marker (center is clear) -->
    <body name="robot_safe_area" pos="0 0 0.02">
      <geom type="cylinder" size="1.0 0.01" rgba="0 1 0 0.2"/>
    </body>
  </worldbody>
</mujoco>