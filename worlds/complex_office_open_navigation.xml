<mujoco model="stretch complex office - open navigation">
  <include file="./stretch_mujoco/stretch_mujoco/models/stretch.xml"/>
  
  <!-- Aggressive physics optimization for maximum speed -->
  <option timestep="0.01" gravity="0 0 -9.81" iterations="25" solver="PGS"/>

  <statistic center="0 0 .75" extent="15" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <!-- Materials -->
    <material name="floor_mat" rgba="0.8 0.8 0.9 1" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.9 0.9 0.8 1" reflectance="0.1"/>
    <material name="door_mat" rgba="0.6 0.4 0.2 1" reflectance="0.1"/>
    <material name="office_mat" rgba="0.7 0.8 0.9 1" reflectance="0.1"/>
    <material name="lab_mat" rgba="0.9 0.7 0.7 1" reflectance="0.1"/>
    <material name="furniture_mat" rgba="0.5 0.3 0.2 1" reflectance="0.1"/>
    <texture type="skybox" builtin="gradient" rgb1="0.44 0.80 1.00" rgb2="1 1 1" width="512" height="3072"/>
  </asset>
  
  <worldbody>
    <!-- Lighting -->
    <light name="main_light" pos="0 0 4" dir="0 0 -1" diffuse="1 1 1"/>
    <light name="ambient" pos="0 0 0" dir="0 0 -1" diffuse="0.4 0.4 0.4"/>
    
    <!-- Floor -->
    <geom name="floor" type="plane" size="12.5 10 0.1" material="floor_mat" pos="0 0 0"/>
    
    <!-- External Walls (KEEP - Define environment boundaries) -->
    <geom name="wall_north" type="box" size="12.5 0.1 1.5" pos="0 9.9 1.5" material="wall_mat"/>
    <geom name="wall_south" type="box" size="12.5 0.1 1.5" pos="0 -9.9 1.5" material="wall_mat"/>
    <geom name="wall_east" type="box" size="0.1 10 1.5" pos="12.4 0 1.5" material="wall_mat"/>
    <geom name="wall_west" type="box" size="0.1 10 1.5" pos="-12.4 0 1.5" material="wall_mat"/>
    
    <!-- REMOVED: Main Corridor walls (lines 38-39) - Allow open navigation -->
    <!-- REMOVED: All Vertical Corridor walls (lines 42-52) - Major navigation barriers -->
    <!-- REMOVED: Laboratory separation walls (lines 73,76) - Block north/south areas -->
    
    <!-- Office Rooms - MODIFIED: Remove some partition walls for openings -->
    <!-- Office 1 (NE) - Keep south wall only, remove west wall for access -->
    <geom name="office1_wall_s" type="box" size="3.8 0.1 1.5" pos="8.7 3.5 1.5" material="office_mat"/>
    <!-- REMOVED: office1_wall_w for open access -->
    
    <!-- Office 2 (NW) - Keep south wall only, remove east wall for access -->
    <geom name="office2_wall_s" type="box" size="3.8 0.1 1.5" pos="-8.7 3.5 1.5" material="office_mat"/>
    <!-- REMOVED: office2_wall_e for open access -->
    
    <!-- Office 3 (SE) - Keep north wall only, remove west wall for access -->
    <geom name="office3_wall_n" type="box" size="3.8 0.1 1.5" pos="8.7 -3.5 1.5" material="office_mat"/>
    <!-- REMOVED: office3_wall_w for open access -->
    
    <!-- Office 4 (SW) - Keep north wall only, remove east wall for access -->  
    <geom name="office4_wall_n" type="box" size="3.8 0.1 1.5" pos="-8.7 -3.5 1.5" material="office_mat"/>
    <!-- REMOVED: office4_wall_e for open access -->
    
    <!-- Conference Room (Center East) - MODIFIED: Create opening -->
    <geom name="conf_wall_w" type="box" size="0.1 0.6 1.5" pos="9.9 0.7 1.5" material="office_mat"/>
    <!-- OPENING: 1.6m gap created for robot access -->
    <geom name="conf_wall_w2" type="box" size="0.1 0.6 1.5" pos="9.9 -0.7 1.5" material="office_mat"/>
    <geom name="conf_wall_n" type="box" size="2.4 0.1 1.5" pos="11.3 1.4 1.5" material="office_mat"/>
    <geom name="conf_wall_s" type="box" size="2.4 0.1 1.5" pos="11.3 -1.4 1.5" material="office_mat"/>
    
    <!-- Storage Room (Center West) - MODIFIED: Create opening -->
    <geom name="storage_wall_e" type="box" size="0.1 0.6 1.5" pos="-9.9 0.7 1.5" material="office_mat"/>
    <!-- OPENING: 1.6m gap created for robot access -->
    <geom name="storage_wall_e2" type="box" size="0.1 0.6 1.5" pos="-9.9 -0.7 1.5" material="office_mat"/>
    <geom name="storage_wall_n" type="box" size="2.4 0.1 1.5" pos="-11.3 1.4 1.5" material="office_mat"/>
    <geom name="storage_wall_s" type="box" size="2.4 0.1 1.5" pos="-11.3 -1.4 1.5" material="office_mat"/>
    
    <!-- Furniture and Obstacles -->
    <!-- Office 1 furniture -->
    <body name="desk1" pos="8 5 0.4">
      <geom type="box" size="0.8 0.4 0.4" material="furniture_mat"/>
    </body>
    <body name="chair1" pos="8 4.2 0.25">
      <geom type="cylinder" size="0.3 0.25" material="furniture_mat"/>
    </body>
    
    <!-- Office 2 furniture -->
    <body name="desk2" pos="-8 5 0.4">
      <geom type="box" size="0.8 0.4 0.4" material="furniture_mat"/>
    </body>
    <body name="chair2" pos="-8 4.2 0.25">
      <geom type="cylinder" size="0.3 0.25" material="furniture_mat"/>
    </body>
    
    <!-- Office 3 furniture -->
    <body name="desk3" pos="8 -5 0.4">
      <geom type="box" size="0.8 0.4 0.4" material="furniture_mat"/>
    </body>
    <body name="chair3" pos="8 -4.2 0.25">
      <geom type="cylinder" size="0.3 0.25" material="furniture_mat"/>
    </body>
    
    <!-- Office 4 furniture -->
    <body name="desk4" pos="-8 -5 0.4">
      <geom type="box" size="0.8 0.4 0.4" material="furniture_mat"/>
    </body>
    <body name="chair4" pos="-8 -4.2 0.25">
      <geom type="cylinder" size="0.3 0.25" material="furniture_mat"/>
    </body>
    
    <!-- Conference room table -->
    <body name="conf_table" pos="11 0 0.4">
      <geom type="box" size="1.2 0.8 0.4" material="furniture_mat"/>
    </body>
    
    <!-- Lab equipment - NOW ACCESSIBLE -->
    <body name="lab_bench1" pos="2 8.5 0.45">
      <geom type="box" size="1.5 0.3 0.45" material="furniture_mat"/>
    </body>
    <body name="lab_bench2" pos="-2 8.5 0.45">
      <geom type="box" size="1.5 0.3 0.45" material="furniture_mat"/>
    </body>
    <body name="lab_bench3" pos="2 -8.5 0.45">
      <geom type="box" size="1.5 0.3 0.45" material="furniture_mat"/>
    </body>
    <body name="lab_bench4" pos="-2 -8.5 0.45">
      <geom type="box" size="1.5 0.3 0.45" material="furniture_mat"/>
    </body>
    
    <!-- Storage shelves -->
    <body name="shelf1" pos="-11 0.8 0.8">
      <geom type="box" size="0.2 0.5 0.8" material="furniture_mat"/>
    </body>
    <body name="shelf2" pos="-11 -0.8 0.8">
      <geom type="box" size="0.2 0.5 0.8" material="furniture_mat"/>
    </body>
    
    <!-- Corridor obstacles - REDUCED for better navigation -->
    <body name="water_cooler" pos="1.5 0 0.6">
      <geom type="cylinder" size="0.2 0.6" material="furniture_mat"/>
    </body>
    <body name="plant1" pos="-1.5 0 0.3">
      <geom type="cylinder" size="0.15 0.3" rgba="0.2 0.8 0.2 1"/>
    </body>
    
    <!-- Fire extinguisher boxes - MOVED to not block main paths -->
    <body name="fire_ext1" pos="6 1.4 0.8">
      <geom type="box" size="0.1 0.1 0.3" rgba="1 0 0 1"/>
    </body>
    <body name="fire_ext2" pos="-6 -1.4 0.8">
      <geom type="box" size="0.1 0.1 0.3" rgba="1 0 0 1"/>
    </body>
  </worldbody>
</mujoco>